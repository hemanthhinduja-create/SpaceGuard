# Copy to server/.env and edit. NEVER commit the real .env file.
PORT=4000
# Local MongoDB, or paste your MongoDB Atlas connection string here (in your own .env only)
MONGODB_URI=mongodb://127.0.0.1:27017/spaceguard
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development
